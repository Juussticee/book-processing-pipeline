APP_NAME=Book Processor
VERSION=0.1.0
ENVIRONMENT=Development
LOG_LEVEL=INFO

# Paths
DATA_DIRECTORY=data
LOG_DIRECTORY=logs
TEMP_DIRECTORY=data/temp
COVERS_DIR=data/covers

# Google Drive Sync
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
# Downloads and processed files live under DATA_DIRECTORY
# (data/downloads, data/processed); the code hardcodes those subfolders.

# Google Sheets Export (Milestone 5)
GOOGLE_SHEET_ID=
GOOGLE_SHEETS_CREDENTIALS=credentials/service_account.json
GOOGLE_SHEETS_TAB_NAME=Sheet1
COVER_DOWNLOAD_TIMEOUT=10
COVER_MIN_WIDTH=200
COVER_MIN_HEIGHT=200
EXPORT_MAX_RETRIES=3
EXPORT_RETRY_DELAY=60

# OCR (Baidu AI Studio PaddleOCR-VL; no local OCR engine is used)
OCR_LANGUAGE=en,fr
OCR_USE_GPU=false
OCR_CONFIDENCE_THRESHOLD=0.5

# PaddleOCR-VL (Baidu AI Studio)
# Required: access token for the PaddleOCR-VL-1.6 API. Production OCR provider.
PADDLEOCR_API_TOKEN=

# Book Lookup APIs
GOOGLE_BOOKS_API_KEY=
EXA_API_KEY=
GOOGLE_BOOKS_TIMEOUT=15
OPEN_LIBRARY_ENABLED=true
OPEN_LIBRARY_TIMEOUT=10

# Book Identification
CONFIDENCE_THRESHOLD=0.85
CONFIDENCE_MANUAL_REVIEW_THRESHOLD=0.50
CONFIDENCE_REJECTED_THRESHOLD=0.50

# Debug artifact retention (Milestone 8.5)
DEBUG_RETENTION_DAYS=3

# Intake limits and job timeout - defaults are production-safe.
# Uncomment only to change them; the intake gate rejects files above the
# size limit before download (docs/BOOK_INTAKE_GUIDE.md quotes 20 MB).
# IMAGE_MAX_FILE_SIZE_MB=20
# IMAGE_MAX_WIDTH=4000
# IMAGE_MAX_HEIGHT=4000
# PROCESSING_TIMEOUT_SECONDS=900

# Retry backoff for failed jobs (defaults are production-safe)
# RETRY_INITIAL_DELAY_SECONDS=5
# RETRY_MAX_DELAY_SECONDS=300
# RETRY_BACKOFF_FACTOR=2

# Vision fallback - NOT an OCR provider and not part of production.
# Leave VISION_CACHE_DIR, OLLAMA_HOST and LOCAL_VLM_MODEL unset: with a
# cache directory present, cached benchmark extractions override OCR text.
# VISION_CACHE_DIR=
# OLLAMA_HOST=
# LOCAL_VLM_MODEL=

# Gemini Recovery (Phase 18 — secondary recovery for low-confidence books)
# Only invoked when existing pipeline confidence < 0.70
GEMINI_API_KEY=
GEMINI_RECOVERY_ENABLED=false
GEMINI_DAILY_MAX_REQUESTS=50
GEMINI_RPM_LIMIT=15
